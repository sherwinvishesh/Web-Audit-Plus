{
  "name": "webauditplus",
  "version": "0.1.0",
  "private": true,
  "description": "Web Audit+ audits the page you are on for Performance, Accessibility, Best Practices, SEO and Agentic readiness, as a Chrome MV3 extension.",
  "license": "Apache-2.0",
  "author": "Sherwin Vishesh Jathanna",
  "homepage": "https://sherwinvishesh.github.io/Web-Audit-Plus/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sherwinvishesh/Web-Audit-Plus.git"
  },
  "bugs": {
    "url": "https://github.com/sherwinvishesh/Web-Audit-Plus/issues"
  },
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "wxt build && vitest run --config vitest.e2e.config.ts",
    "icons": "node scripts/gen-icons.mjs"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@webauditplus/engine": "0.1.0",
    "axe-core": "^4.14.0",
    "linkedom": "^0.18.13",
    "puppeteer-core": "^25.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/chrome": "^0.3.5",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@wxt-dev/module-react": "^1.2.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^21.0.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4",
    "wxt": "^0.21.4"
  }
}
